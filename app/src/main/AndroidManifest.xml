<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage / Media Permissions for Food Images -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodResQ">

        <!-- Splash / Launcher Activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FoodResQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Donor Activities -->
        <activity
            android:name=".DonorHomeActivity"
            android:exported="false" />

        <activity
            android:name=".AddDonationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MyDonationsActivity"
            android:exported="false" />

        <activity
            android:name=".DonationDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".DonorRequestsActivity"
            android:exported="false" />

        <activity
            android:name=".DonorProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Receiver Activities -->
        <activity
            android:name=".ReceiverHomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".FoodDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".MyRequestsActivity"
            android:exported="false" />

        <activity
            android:name=".RequestDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ReceiverProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Legacy MainActivity redirected to Splash -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>